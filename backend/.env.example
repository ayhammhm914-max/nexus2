# App
NODE_ENV=development
PORT=3001
API_VERSION=v1
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=mysql://root:123258456789%40@127.0.0.1:3307/nexus_db
REDIS_URL=redis://default:nexus@localhost:6379

# JWT (PEM values can be raw multiline or escaped with \n)
JWT_ACCESS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----
JWT_ACCESS_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----
JWT_REFRESH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----
JWT_REFRESH_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace_me\n-----END PUBLIC KEY-----
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_KEY_ID=dev-v1

# Encryption
AES_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AES_IV_LENGTH=16

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# OAuth
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
DISCORD_CLIENT_ID=replace_me
DISCORD_CLIENT_SECRET=replace_me
DISCORD_CALLBACK_URL=http://localhost:3001/api/v1/auth/discord/callback

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=replace_me
EMAIL_FROM=noreply@nexus.gg
EMAIL_FROM_NAME=NEXUS

# Storage
S3_BUCKET_NAME=nexus-assets
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
S3_ENDPOINT=

# Monitoring
SENTRY_DSN=

# Security / App
BCRYPT_ROUNDS=12
MAX_CART_ITEMS=20
GUEST_CHECKOUT_ENABLED=true
LOYALTY_POINTS_RATE=10
TRUST_PROXY=false
CSRF_SECRET=replace_me
APP_BASE_URL=http://localhost:3001
